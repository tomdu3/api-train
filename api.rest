# GET /api/v1/products returns a list of all products
GET http://localhost:5000/api/v1/products

###

# GET /api/v1/products/<id> returns a specific product by ID
GET http://localhost:5000/api/v1/products/1

###

# POST /api/v1/products creates a new product
POST http://localhost:5000/api/v1/products
Content-Type: application/json

{
    "name": "Product 1",
    "description": "Description 1",
    "price": 34,
    "in_stock": false
}

###

# PUT /products/<id> updates a specific product by ID
PUT http://localhost:5000/products/10
Content-Type: application/json

{
    "name": "Product 1",
    "description": "Description 1",
    "price": 10.00
}

###

# PATCH /products/<id> updates a specific product by ID
PATCH http://localhost:5000/products/10
Content-Type: application/json

{
    "name": "Some cool name",
    "description": "Cool description",
    "hello": "world"
}

###

# DELETE /products/<id> deletes a specific product by ID
DELETE http://localhost:5000/api/v1/products/16

###